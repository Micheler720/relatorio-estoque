                  WHERE fnb_cod NOT IN (\'2.01.001.0006\', \'2.01.001.0001\', \'2.01.001.0002\') 
                  AND MONTH(fn2.fn2_emis ) = @mes
                  AND YEAR(fn2_emis) = @ano
                  AND fn2_empresa = @empresa)
          INTO @valorDespesaLoja;


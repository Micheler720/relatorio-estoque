                  (SELECT 
                      IFNULL(SUM(f.fn5_valor), 0) AS \'Saida \'
                  FROM fn5 f 
                  INNER JOIN cg6 c ON c.cg6_cod = f.cg6_cod
                  WHERE  c.cg6_caixa = 1 
                  AND f.fn5_recpag = \'S\' 
                  AND MONTH(f.fn5_data ) = @mes

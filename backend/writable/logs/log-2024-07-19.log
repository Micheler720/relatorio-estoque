                  WHERE MONTH(r.data) = @mes
                  AND YEAR(r.data) = @ano
                  AND r.empresa = @empresa)
          INTO @valorVendaBruta;

          SET @valorDespesaLoja = 0;

          SELECT (SELECT 
                      IFNULL(sum(fn2_valor), 0) valor  
